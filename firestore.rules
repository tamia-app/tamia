rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['banks', 'onboarded', 'createdAt', 'updatedAt', 'recurring', 'lastGoal']);
      match /months/{month} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && month.matches('^[0-9]{4}-[0-9]{2}$');
      }
    }
  }
}
